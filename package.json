{
  "name": "node-grpc-typescript",
  "version": "0.1.0",
  "description": "Node.js gRPC Structure for TypeScript Example",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint",
    "build": "node bin/proto && rimraf dist && tsc -b",
    "start": "node --enable-source-maps dist/server",
    "client": "node --enable-source-maps dist/client",
    "health": "node --enable-source-maps dist/health"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "consola": "3.4.2",
    "grpc-health-check": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^4.0.2",
    "grpc-tools": "^1.13.1",
    "rimraf": "^6.1.3",
    "ts-proto": "^2.11.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CatsMiaow/node-grpc-typescript.git"
  },
  "keywords": [
    "Node.js",
    "gRPC",
    "TypeScript"
  ],
  "homepage": "https://github.com/CatsMiaow/node-grpc-typescript#readme",
  "author": "CatsMiaow",
  "license": "MIT"
}
